datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id               Int      @id @default(autoincrement())
  headerL1         String?  @default("Kementerian Imigrasi Dan Pemasyarakatan")
  headerL2         String?  @default("Direktorat Jenderal Pemasyarakatan")
  headerL3         String?  @default("Kantor Wilayah Banten")
  headerL4         String?  @default("Balai Pemasyarakatan Kelas II Ciangir")
  headerL5         String?  @default("LAPORAN HARIAN INFOGRAFIS")
  
  pegawaiHadir     Int?     @default(25)
  pegawaiCuti      Int?     @default(2)
  pegawaiDL        Int?     @default(3)

  klienPbDl        Int?     @default(1163)
  klienPbAl        Int?     @default(14)
  klienPbDp        Int?     @default(53)
  klienPbAp        Int?     @default(0)

  klienCbDl        Int?     @default(62)
  klienCbAl        Int?     @default(1)
  klienCbDp        Int?     @default(3)
  klienCbAp        Int?     @default(0)

  klienCmbDl       Int?     @default(0)
  klienCmbAl       Int?     @default(0)
  klienCmbDp       Int?     @default(0)
  klienCmbAp       Int?     @default(0)

  klienAsiDl       Int?     @default(0)
  klienAsiAl       Int?     @default(5)
  klienAsiDp       Int?     @default(0)
  klienAsiAp       Int?     @default(0)

  perkaraNarkotika String?  @default("582(D)/1(A)")
  perkaraTerorisme String?  @default("3(D)/0(A)")
  perkaraKorupsi   String?  @default("20(D)/0(A)")
  perkaraPidum     String?  @default("695(D)/18(A)")

  litmasDAsi       String?  @default("3")
  litmasDCb        String?  @default("439")
  litmasDPindah    String?  @default("87")
  litmasADiv       String?  @default("12")
  litmasAPeradil   String?  @default("48")
  litmasAPb        String?  @default("3")

  klienBaruPb      Int?     @default(0)
  klienBaruCb      Int?     @default(0)
  klienBaruCmb     Int?     @default(0)
  klienBaruPib     Int?     @default(0)
  klienBaruCmk     Int?     @default(0)

  wajibLaporPb     Int?     @default(0)
  wajibLaporCb     Int?     @default(0)
  wajibLaporCmb    Int?     @default(0)
  wajibLaporCmk    Int?     @default(0)

  petugasNama      String?  @default("FIKRI & FAOZI")
  fotoPiketiBase64 String?

  updatedAt        DateTime @updatedAt
}
